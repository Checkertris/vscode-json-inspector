{
    "name": "component-gallery-react",
    "displayName": "component-gallery-react",
    "description": "A sample extension to show off all React components in the Webview UI Toolkit for Visual Studio Code.",
    "version": "0.0.1",
    "engines": {
        "vscode": "^1.75.0"
    },
    "main": "./out/extension.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "type": "webview",
                    "id": "extension.mainView",
                    "name": "Calico Colors"
                }
            ]
        },
        "commands": [
            {
                "command": "component-gallery-react.showGallery",
                "title": "Component Gallery (React): Show"
            }
        ]
    },
    "scripts": {
        "compile": "npm run check-types && node esbuild.js",
        "check-types": "tsc --noEmit",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "vscode:prepublish": "npm run package",
        "package": "npm run check-types && node esbuild.js --production",
        "install:all": "npm install && cd webview-ui && npm install",
        "start:webview": "cd webview-ui && npm run start",
        "build:webview": "cd webview-ui && npm run build",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts"
    },
    "devDependencies": {
        "@types/glob": "^7.1.3",
        "@types/node": "^12.11.7",
        "@types/vscode": "^1.46.0",
        "@typescript-eslint/eslint-plugin": "^4.14.1",
        "@typescript-eslint/parser": "^4.14.1",
        "esbuild": "^0.23.1",
        "eslint": "^7.19.0",
        "glob": "^7.1.6",
        "prettier": "^2.2.1",
        "typescript": "^4.1.3",
        "vscode-test": "^1.5.0",
        "npm-run-all": "^4.1.5"
    }
}
